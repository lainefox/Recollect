<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
	<id>@APP_ID@</id>
	<metadata_license>CC0-1.0</metadata_license>
	<project_license>GPL-3.0</project_license>
	<name>Recollect</name>
	<summary>Search for text inside your images using OCR</summary>
	<description>
		<p>Recollect scans images with Tesseract OCR, indexes extracted text in a local database, and provides a fast search UI.</p>
	</description>
	<launchable type="desktop-id">@APP_ID@.desktop</launchable>
	<screenshots>
	</screenshots>
	<releases>
		<release version="1.2.0" date="2026-09-06">
			<description>
				<ul>
					<li>Add --background launch option and Start at Login toggle</li>
					<li>Fix open containing folder not working in the flatpak on KDE</li>
				</ul>
			</description>
		</release>
		<release version="1.1.1" date="2026-09-06">
			<description>
				<p>Fix desktop entry so the app always appears in the app grid with its icon.</p>
			</description>
		</release>
		<release version="1.1.0" date="2026-09-06">
			<description>
				<ul>
					<li>Install multiple model qualities (fast, balanced, best) per language</li>
					<li>Manage each model variant independently in the preferences dialog</li>
					<li>Fix stale OCR model chips in the sidebar after rescanning folders</li>
					<li>Fix Escape key not closing the sidebar</li>
					<li>Add installation instructions for flatpak, AUR, and native tarball</li>
				</ul>
			</description>
		</release>
		<release version="1.0.0" date="2026-09-02">
			<description>
				<p>Initial release.</p>
			</description>
		</release>
		<release version="0.1.0" date="2026-06-25">
			<description>
				<p>Initial release.</p>
			</description>
		</release>
	</releases>
</component>
